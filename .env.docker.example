# barrier-free-meetings — Docker Compose environment template
#
# Copy to `.env` before `docker compose up`:
#   cp .env.docker.example .env
#
# Values here are passed into the container via docker-compose.yml.
# Never commit a real `.env` with secrets.

# --- Host port mapping -------------------------------------------------------
BFM_PORT=3000

# --- Speech ------------------------------------------------------------------
BFM_WHISPER_MODEL=tiny
BFM_DISABLE_AUTO_SETUP=false
BFM_MAX_ACTIVE_TRANSCRIPTIONS=2
BFM_MAX_QUEUE_SIZE=4
BFM_MAX_WS_CONNECTIONS=4

# --- Translation providers (fill what you want) ------------------------------
OPENROUTER_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
MINIMAX_API_KEY=

# Reach Ollama on the Docker host (Docker Desktop + Linux with host-gateway).
# Leave blank / comment out if you do not use local Ollama.
OLLAMA_HOST=http://host.docker.internal:11434

# --- CORS --------------------------------------------------------------------
BFM_CORS_ALLOWED_ORIGINS=http://localhost:3000,capacitor://localhost
